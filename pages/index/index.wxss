.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #FFFFFF;
}

.header {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F1F5F9;
}

.logo {
  width: 56rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2933;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.section {
  padding: 40rpx 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2933;
  padding-left: 16rpx;
  border-left: 6rpx solid #1F2933;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-row .section-title {
  border-left: none;
  padding-left: 0;
  margin-bottom: 0;
}

.more {
  font-size: 24rpx;
  color: #9CA3AF;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.cat-item {
  background: #FAFAFA;
  border: 1rpx solid #E5E7EB;
  padding: 24rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1F2933;
}

.divider {
  height: 1rpx;
  background: #F1F5F9;
  margin: 0 32rpx;
}

.product-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.product-item {
  background: #FAFAFA;
}

.product-img {
  width: 100%;
  height: 200rpx;
  background: #F8FAFC;
  border: 1rpx solid #F1F5F9;
  overflow: hidden;
}

.product-img image {
  width: 100%;
  height: 100%;
}

.product-name {
  font-size: 22rpx;
  color: #1F2933;
  padding: 12rpx 8rpx;
  text-align: center;
}

.footer {
  text-align: center;
  color: #9CA3AF;
  font-size: 22rpx;
  padding: 48rpx 0 24rpx;
}
