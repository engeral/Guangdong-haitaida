.page {
  min-height: 100vh;
  background: #FFFFFF;
}

.hero {
  width: 100%;
  height: 600rpx;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #F1F5F9;
}

.hero image {
  width: 100%;
  height: 100%;
}

.hero-fallback {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 32rpx;
  text-align: center;
}

.content {
  padding: 40rpx 32rpx 80rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2933;
  margin-bottom: 48rpx;
  letter-spacing: 1rpx;
}

.row {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.row-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #9CA3AF;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  color: #1F2933;
  line-height: 1.6;
}
