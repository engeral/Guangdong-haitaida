<view class="page" wx:if="{{product}}">

  <!-- 图集:有 image(images 数组或单 image)就轮播,都没有就显示占位 -->
  <swiper class="hero" wx:if="{{hasImage}}" indicator-dots="{{heroDots}}" autoplay="{{false}}" circular="{{false}}" bindchange="onSwiperChange">
    <block wx:for="{{product.images || [product.image]}}" wx:key="*this">
      <swiper-item>
        <image src="{{item}}" mode="aspectFit" bindtap="onTapImage" data-url="{{item}}"></image>
      </swiper-item>
    </block>
  </swiper>
  <view class="hero hero-fallback" wx:else>
    <text>{{product.name}}</text>
  </view>

  <view class="content">
    <view class="name">{{product.name}}</view>

    <view class="row">
      <view class="row-label">主要成分</view>
      <view class="row-value">{{product.ingredient}}</view>
    </view>

    <view class="row">
      <view class="row-label">适用场景</view>
      <view class="row-value">{{product.scene}}</view>
    </view>

    <view class="row">
      <view class="row-label">包装规格</view>
      <view class="row-value">{{product.spec}}</view>
    </view>
  </view>

  <!-- 全屏图片预览 -->
  <view class="viewer-mask" wx:if="{{viewerUrl}}" bindtap="closeViewer">
    <image src="{{viewerUrl}}" mode="aspectFit" show-menu-by-longpress="true"></image>
  </view>

</view>
