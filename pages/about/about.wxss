.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background: #FFFFFF;
}

.header {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F1F5F9;
}

.logo {
  width: 56rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2933;
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.subtitle {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.section {
  padding: 40rpx 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2933;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1F2933;
}

.section-body {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.8;
}

.divider {
  height: 1rpx;
  background: #F1F5F9;
  margin: 0 32rpx;
}

.qual-list {
  display: flex;
  flex-direction: column;
}

.qual-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.qual-dot {
  width: 8rpx;
  height: 8rpx;
  background: #1F2933;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.qual-text {
  font-size: 26rpx;
  color: #4B5563;
}

.license-block {
  padding: 0 32rpx 40rpx;
}

.license-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2933;
  padding-left: 16rpx;
  border-left: 6rpx solid #1F2933;
  margin-bottom: 12rpx;
}

.license-sub {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 20rpx;
}

.license-img {
  width: 100%;
  background: #F8FAFC;
  border: 1rpx solid #E5E7EB;
}

.range-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.range-item {
  background: #FAFAFA;
  border: 1rpx solid #E5E7EB;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #1F2933;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.contact-value {
  font-size: 26rpx;
  color: #1F2933;
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  line-height: 1.5;
}

.footer {
  text-align: center;
  color: #9CA3AF;
  font-size: 22rpx;
  padding: 48rpx 0 24rpx;
}
